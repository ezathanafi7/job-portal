# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite locally. Example for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/jobportal
DATABASE_URL=
# Generate with: uv run python manage.py generate_jwt_keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7